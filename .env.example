# =====================================================
# GLPI
# =====================================================

GLPI_URL=https://glpi.example.local

# legacy | highlevel | hybrid
GLPI_API_MODE=legacy

# High-Level API version used to build /api.php/{version} URLs.
GLPI_API_VERSION=2.3

# =====================================================
# AUTHENTICATION
# =====================================================

# service_account | per_user
GLPI_AUTH_MODE=service_account

# =====================================================
# LEGACY / SERVICE ACCOUNT
# =====================================================

GLPI_APP_TOKEN=CHANGE_ME
GLPI_USER_TOKEN=CHANGE_ME

# Alternative supported for Legacy, not preferred for this deployment:
# GLPI_USERNAME=CHANGE_ME
# GLPI_PASSWORD=CHANGE_ME

# =====================================================
# HIGH-LEVEL / OAUTH PLACEHOLDERS
# =====================================================

# Confirm exact OAuth requirements from the target GLPI 11 Swagger/OpenAPI
# before enabling High-Level write or per-user flows.
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_OAUTH_REDIRECT_URI=

# =====================================================
# HTTP
# =====================================================

GLPI_TIMEOUT_MS=15000
GLPI_MAX_RETRIES=2
# GLPI_DEBUG=1

# =====================================================
# MCP
# =====================================================

MCP_BIND_ADDRESS=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_HEALTH_PATH=/healthz
MCP_SESSION_TIMEOUT_MS=600000
MCP_LOG_LEVEL=info

# =====================================================
# BUILD METADATA
# =====================================================

GLPI_MCP_DOCKER_VERSION=v2-alpha
UPSTREAM_LEGACY_VERSION=v3.3.0
SUPERGATEWAY_VERSION=3.4.3
