# =====================================================
# GLPI
# =====================================================

GLPI_URL=https://glpi.example.local

# legacy | highlevel | hybrid
GLPI_API_MODE=legacy

# High-Level API version used to build /api.php/v{version} URLs.
# The High-Level backend is still in preparation; keep legacy in production.
GLPI_API_VERSION=2.3

# =====================================================
# AUTHENTICATION
# =====================================================

# service_account is active. per_user is reserved for future OAuth support.
GLPI_AUTH_MODE=service_account

# =====================================================
# LEGACY / SERVICE ACCOUNT
# =====================================================

# Use a dedicated technical account with deliberately limited GLPI rights.
GLPI_APP_TOKEN=CHANGE_ME
GLPI_USER_TOKEN=CHANGE_ME

# Alternative supported for Legacy, not preferred for this deployment:
# GLPI_USERNAME=CHANGE_ME
# GLPI_PASSWORD=CHANGE_ME

# =====================================================
# HIGH-LEVEL / OAUTH PLACEHOLDERS
# =====================================================

# Inactive placeholders. Do not populate unless High-Level/OAuth support has
# been explicitly enabled and validated for the target GLPI instance.
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_OAUTH_USERNAME=
GLPI_OAUTH_PASSWORD=
GLPI_OAUTH_REDIRECT_URI=

# =====================================================
# HTTP
# =====================================================

GLPI_TIMEOUT_MS=15000
GLPI_MAX_RETRIES=2
# GLPI_DEBUG=1

# =====================================================
# MCP
# =====================================================

# Safe default: publish only on the Docker host. Set 0.0.0.0 only when a
# firewall or authenticated reverse proxy protects the endpoint.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_HEALTH_PATH=/healthz
MCP_SESSION_TIMEOUT_MS=600000
MCP_LOG_LEVEL=info

# glpi_upload_document may only read regular files below this directory.
MCP_UPLOAD_ROOT=/uploads
MCP_UPLOAD_MAX_BYTES=26214400
# Host directory mounted read-only at MCP_UPLOAD_ROOT by docker-compose.yml.
MCP_UPLOAD_SOURCE=./uploads
